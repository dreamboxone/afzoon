{
  "luci-app-afzoon": {
    "description": "Grant Afzoon LuCI page access to its local management command",
    "read": {
      "uci": [ "afzoon" ],
      "ubus": {
        "session": [ "access" ],
        "file": [ "exec" ]
      }
    },
    "write": {
      "cgi-io": [ "exec" ],
      "uci": [ "afzoon" ],
      "ubus": {
        "file": [ "exec" ]
      },
      "file": {
        "/usr/sbin/afzoonctl": [ "exec" ]
      }
    }
  }
}
