#!/bin/sh
# Afzoon local storage manager. All destructive work is explicitly requested by LuCI.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
STATE_DIR=/var/run/afzoon
STATE_FILE=$STATE_DIR/status.json
JOB_LOCK=$STATE_DIR/apply.lock
JOB_FILE=$STATE_DIR/apply-job.json
mkdir -p "$STATE_DIR"

json_quote() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\n/ /g'; }
is_uint() { case "$1" in ''|*[!0-9]*) return 1;; *) return 0;; esac; }
reply_error() { printf '{"ok":false,"error":"%s"}\n' "$(json_quote "$1")"; return 0; }
dev_base() { basename "$1" | sed 's/[0-9]*$//'; }
block_value() { block info "$1" 2>/dev/null | sed -n "s/.* $2=\"\([^\"]*\)\".*/\1/p" | head -n1; }

usb_block() {
	b=$(dev_base "$1")
	[ -b "/dev/$b" ] || return 1
	p=$(readlink -f "/sys/class/block/$b/device" 2>/dev/null) || return 1
	echo "$p" | grep -q '/usb[0-9]'
}

usb_speed() {
	b=$(dev_base "$1"); p=$(readlink -f "/sys/class/block/$b/device" 2>/dev/null)
	while [ -n "$p" ] && [ "$p" != / ]; do
		if [ -r "$p/speed" ]; then cat "$p/speed"; return; fi
		p=$(dirname "$p")
	done
	echo 0
}

usb_generation() {
	s=$(usb_speed "$1" | cut -d. -f1)
	is_uint "$s" || s=0
	if [ "$s" -ge 20000 ]; then echo 'USB 3.2 (20 Gbit/s)'
	elif [ "$s" -ge 10000 ]; then echo 'USB 3.1/3.2 (10 Gbit/s)'
	elif [ "$s" -ge 5000 ]; then echo 'USB 3.0 (5 Gbit/s)'
	elif [ "$s" -ge 480 ]; then echo 'USB 2.0 (480 Mbit/s)'
	elif [ "$s" -gt 0 ]; then echo 'USB 1.x'
	else echo 'Unknown'; fi
}

device_json() {
	b=$1; dev=/dev/$b; sys=/sys/block/$b/device
	[ -b "$dev" ] || return
	size=$(cat "/sys/block/$b/size" 2>/dev/null); is_uint "$size" || size=0; mib=$((size / 2048))
	brand="$(cat "$sys/vendor" 2>/dev/null) $(cat "$sys/model" 2>/dev/null)"; brand=$(echo "$brand" | sed 's/^ *//;s/ *$//')
	parts=''; first=1
	for p in /sys/block/$b/$b*; do
		[ -e "$p" ] || continue; n=$(basename "$p"); [ "$n" = "$b" ] && continue
		fs=$(block_value "/dev/$n" TYPE); uuid=$(block_value "/dev/$n" UUID)
		ps=$(cat "$p/size" 2>/dev/null); is_uint "$ps" || ps=0
		[ $first -eq 1 ] || parts="$parts,"; first=0
		parts="$parts{\"name\":\"$(json_quote "$n")\",\"size_mib\":$((ps / 2048)),\"filesystem\":\"$(json_quote "${fs:-unknown}")\",\"uuid\":\"$(json_quote "$uuid")\"}"
	done
	printf '{"name":"%s","path":"%s","size_mib":%s,"brand":"%s","usb":"%s","speed_mbps":"%s","partitions":[%s]}' \
		"$(json_quote "$b")" "$dev" "$mib" "$(json_quote "${brand:-Unknown}")" "$(usb_generation "$dev")" "$(json_quote "$(usb_speed "$dev")")" "$parts"
}

system_json() {
	board=$(ubus call system board 2>/dev/null)
	model=$(echo "$board" | jsonfilter -e '@.model' 2>/dev/null); release=$(echo "$board" | jsonfilter -e '@.release.description' 2>/dev/null)
	target=$(echo "$board" | jsonfilter -e '@.release.target' 2>/dev/null)
	[ -n "$target" ] || target=$(sed -n "s/^DISTRIB_TARGET=['\"]\([^'\"]*\).*/\1/p" /etc/openwrt_release 2>/dev/null)
	arch=$(uname -m)
	mem=$(awk '/MemTotal:/ {printf "%.2f", $2/1024}' /proc/meminfo)
	mem_available=$(awk '/MemAvailable:/ {printf "%.2f", $2/1024}' /proc/meminfo)
	mem_used=$(awk '/MemTotal:/ {t=$2} /^MemFree:/ {f=$2} END {printf "%.2f", (t-f)/1024}' /proc/meminfo)
	mem_buffered=$(awk '/^Buffers:/ {printf "%.2f", $2/1024}' /proc/meminfo)
	mem_cached=$(awk '/^Cached:/ {printf "%.2f", $2/1024}' /proc/meminfo)
	swp=$(awk '/SwapTotal:/ {printf "%.2f", $2/1024}' /proc/meminfo)
	swp_free=$(awk '/SwapFree:/ {printf "%.2f", $2/1024}' /proc/meminfo)
	swp_used=$(awk '/SwapTotal:/ {t=$2} /SwapFree:/ {f=$2} END {printf "%.2f", (t-f)/1024}' /proc/meminfo)
	overlay=$(df -k /overlay 2>/dev/null | awk 'NR==2 {printf "%.2f", $2/1024}'); [ -n "$overlay" ] || overlay=0
	overlay_used=$(df -k /overlay 2>/dev/null | awk 'NR==2 {printf "%.2f", $3/1024}'); [ -n "$overlay_used" ] || overlay_used=0
	tmp_total=$(df -k /tmp 2>/dev/null | awk 'NR==2 {printf "%.2f", $2/1024}'); [ -n "$tmp_total" ] || tmp_total=0
	tmp_used=$(df -k /tmp 2>/dev/null | awk 'NR==2 {printf "%.2f", $3/1024}'); [ -n "$tmp_used" ] || tmp_used=0
	internal=$(uci -q get afzoon.main.internal_overlay_mib); [ -n "$internal" ] || internal=$overlay
	overlay_source=$(awk '$2=="/overlay" {print $1}' /proc/mounts | head -n1)
	case "$overlay_source" in /dev/sd*|/dev/mmcblk*|/dev/nvme*) extroot=$overlay; extroot_used=$overlay_used;; *) extroot=0; extroot_used=0;; esac
	internal_used=$overlay_used; [ "$extroot" = 0 ] || internal_used=0
	virtual=$(awk -v m="${mem:-0}" -v s="${swp:-0}" 'BEGIN {printf "%.2f", m+s}')
	printf '{"model":"%s","openwrt":"%s","architecture":"%s","target_platform":"%s","internal_flash_mib":%s,"internal_flash_used_mib":%s,"active_overlay_mib":%s,"extroot_mib":%s,"extroot_used_mib":%s,"tmp_mib":%s,"tmp_used_mib":%s,"ram_mib":%s,"ram_available_mib":%s,"ram_used_mib":%s,"ram_buffered_mib":%s,"ram_cached_mib":%s,"swap_mib":%s,"swap_used_mib":%s,"virtual_memory_mib":%s}' \
		"$(json_quote "${model:-Unknown}")" "$(json_quote "${release:-Unknown}")" "$(json_quote "$arch")" "$(json_quote "${target:-Unknown}")" "$internal" "$internal_used" "$overlay" "$extroot" "$extroot_used" "$tmp_total" "$tmp_used" "${mem:-0}" "${mem_available:-0}" "${mem_used:-0}" "${mem_buffered:-0}" "${mem_cached:-0}" "${swp:-0}" "${swp_used:-0}" "$virtual"
}

status() {
	devices=''; first=1
	for x in /sys/block/sd*; do [ -e "$x" ] || continue; b=$(basename "$x"); usb_block "/dev/$b" || continue; [ $first -eq 1 ] || devices="$devices,"; first=0; devices="$devices$(device_json "$b")"; done
	lang=$(uci -q get afzoon.main.language); [ -n "$lang" ] || lang=en
	printf '{"version":"1.0.5","language":"%s","system":%s,"devices":[%s],"last_event":"%s"}\n' "$(json_quote "$lang")" "$(system_json)" "$devices" "$(json_quote "$(cat "$STATE_DIR/event" 2>/dev/null)")"
}

set_fstab() {
	dev=$1; swap_uuid=$2; root_uuid=$3
	uci -q delete fstab.afzoon_swap
	uci -q delete fstab.afzoon_extroot
	[ -n "$swap_uuid" ] && { uci -q delete fstab.afzoon_swap; uci set fstab.afzoon_swap=swap; uci set fstab.afzoon_swap.uuid="$swap_uuid"; uci set fstab.afzoon_swap.enabled='1'; }
	[ -n "$root_uuid" ] && { uci -q delete fstab.afzoon_extroot; uci set fstab.afzoon_extroot=mount; uci set fstab.afzoon_extroot.uuid="$root_uuid"; uci set fstab.afzoon_extroot.target='/overlay'; uci set fstab.afzoon_extroot.fstype='ext4'; uci set fstab.afzoon_extroot.options='rw,noatime'; uci set fstab.afzoon_extroot.enabled='1'; uci set fstab.afzoon_extroot.is_rootfs='1'; }
	uci commit fstab
}

overlay_ready() {
	[ -d /overlay ] && awk '$2=="/overlay" {found=1} END {exit !found}' /proc/mounts
}

apply() {
	dev=$1; swap_mib=$2; root_mib=$3
	usb_block "$dev" || { reply_error 'USB device not found'; return; }
	awk '$2=="/overlay" || $2=="/" {print $1}' /proc/mounts | grep -q "$(dev_base "$dev")" && { reply_error 'Active extroot: reboot from internal storage before repartitioning'; return; }
	is_uint "$swap_mib" && is_uint "$root_mib" || { reply_error 'Invalid size'; return; }
	[ "$swap_mib" -gt 0 ] || [ "$root_mib" -gt 0 ] || { reply_error 'Choose swap and/or extroot'; return; }
	b=$(dev_base "$dev"); sectors=$(cat "/sys/block/$b/size"); total=$((sectors / 2048)); used=$((swap_mib + root_mib))
	[ "$used" -le $((total - 16)) ] || { reply_error 'Requested space exceeds device capacity'; return; }
	command -v parted >/dev/null || { reply_error 'parted is required'; return; }
	command -v mkfs.ext4 >/dev/null || { reply_error 'e2fsprogs is required'; return; }
	if [ "$root_mib" -gt 0 ]; then
		overlay_ready || { reply_error 'Extroot requires a mounted /overlay on this firmware; no partitions were changed'; return; }
		internal_overlay_mib=$(df -k /overlay 2>/dev/null | awk 'NR==2 && $2 ~ /^[0-9]+$/ {print int($2/1024)}')
		is_uint "$internal_overlay_mib" || { reply_error 'Cannot read overlay capacity; no partitions were changed'; return; }
	fi
	# This command intentionally erases the selected USB disk; UI confirmation is mandatory.
	swapoff "${dev}"* 2>/dev/null; umount "${dev}"* 2>/dev/null
	parted -s "$dev" mklabel gpt || { reply_error 'Partition table creation failed'; return; }
	start=1; n=1; root_part=''; swap_part=''
	if [ "$root_mib" -gt 0 ]; then end=$((start + root_mib)); parted -s "$dev" mkpart primary ext4 "${start}MiB" "${end}MiB" || { reply_error 'Extroot partition creation failed'; return; }; root_part="${dev}${n}"; n=$((n+1)); start=$end; fi
	if [ "$swap_mib" -gt 0 ]; then end=$((start + swap_mib)); parted -s "$dev" mkpart primary linux-swap "${start}MiB" "${end}MiB" || { reply_error 'Swap partition creation failed'; return; }; swap_part="${dev}${n}"; fi
	partprobe "$dev" 2>/dev/null; sleep 2
	[ -z "$root_part" ] || mkfs.ext4 -F -L afzoon-extroot "$root_part" || { reply_error 'Extroot formatting failed'; return; }
	[ -z "$swap_part" ] || mkswap -L afzoon-swap "$swap_part" || { reply_error 'Swap formatting failed'; return; }
	root_uuid=''; swap_uuid=''
	[ -n "$root_part" ] && root_uuid=$(block_value "$root_part" UUID)
	[ -n "$swap_part" ] && swap_uuid=$(block_value "$swap_part" UUID)
	[ -n "$root_uuid" ] || [ -z "$root_part" ] || { reply_error 'Extroot UUID could not be read'; return; }
	[ -n "$swap_uuid" ] || [ -z "$swap_part" ] || { reply_error 'Swap UUID could not be read'; return; }
	if [ "$root_mib" -gt 0 ]; then uci set afzoon.main.internal_overlay_mib="$internal_overlay_mib"; uci commit afzoon; fi
	set_fstab "$dev" "$swap_uuid" "$root_uuid"
	if [ -n "$root_part" ]; then mkdir -p /tmp/afzoon-extroot; mount "$root_part" /tmp/afzoon-extroot || { reply_error 'Cannot mount new extroot'; return; }; tar -C /overlay -cpf - . | tar -C /tmp/afzoon-extroot -xpf - || { umount /tmp/afzoon-extroot 2>/dev/null; reply_error 'Extroot data copy failed'; return; }; sync; umount /tmp/afzoon-extroot || { reply_error 'Cannot unmount new extroot'; return; }; fi
	[ -n "$swap_part" ] && swapon "$swap_part"
	printf '{"ok":true,"reboot_required":%s}\n' "$([ -n "$root_part" ] && echo true || echo false)"
}

safe_remove() {
	[ ! -d "$JOB_LOCK" ] || { reply_error 'An Apply operation is already in progress'; return; }
	dev=$1; usb_block "$dev" || { reply_error 'USB device not found'; return; }
	awk '$2=="/overlay" {print $1}' /proc/mounts | grep -q "$(dev_base "$dev")" && { reply_error 'Active extroot: disable it and reboot before removal'; return; }
	swapoff "${dev}"* 2>/dev/null
	grep -q "^${dev}" /proc/swaps 2>/dev/null && { reply_error 'Swap is still busy'; return; }
	for p in "${dev}"*; do
		grep -q "^$p " /proc/mounts 2>/dev/null || continue
		umount "$p" 2>/dev/null || { reply_error 'A filesystem is still busy'; return; }
	done
	sync
	b=$(dev_base "$dev"); [ -w "/sys/block/$b/device/delete" ] && echo 1 > "/sys/block/$b/device/delete"
	echo '{"ok":true}'
}

disable_extroot() {
	[ ! -d "$JOB_LOCK" ] || { reply_error 'An Apply operation is already in progress'; return; }
	uci -q delete fstab.afzoon_extroot
	uci commit fstab
	echo '{"ok":true,"reboot_required":true}'
}

start_apply() {
	case "$1" in /dev/sd[a-z]|/dev/sd[a-z][a-z]) ;; *) reply_error 'Invalid USB device'; return;; esac
	is_uint "$2" && is_uint "$3" || { reply_error 'Invalid size'; return; }
	mkdir "$JOB_LOCK" 2>/dev/null || { reply_error 'An Apply operation is already in progress'; return; }
	job_id="$(date +%s)-$$"
	printf '%s\n' "$job_id" > "$STATE_DIR/apply-id"
	printf '{"ok":true,"running":true,"job_id":"%s"}\n' "$job_id" > "$JOB_FILE"
	(trap '' HUP; exec "$0" apply-worker "$job_id" "$1" "$2" "$3") </dev/null >"$STATE_DIR/apply-worker.log" 2>&1 &
	printf '{"ok":true,"running":true,"job_id":"%s"}\n' "$job_id"
}

apply_worker() {
	job_id=$1; shift
	[ "$(cat "$STATE_DIR/apply-id" 2>/dev/null)" = "$job_id" ] && [ -d "$JOB_LOCK" ] || { reply_error 'Unknown Apply operation'; return; }
	trap finish_apply_worker EXIT
	trap '' HUP
	trap 'exit 1' INT TERM
	printf '%s\n' "$$" > "$JOB_LOCK/pid"
	apply "$1" "$2" "$3" >"$STATE_DIR/apply-output.log" 2>"$STATE_DIR/apply.log"
	result=$(tail -n 1 "$STATE_DIR/apply-output.log")
	valid=$(printf '%s\n' "$result" | jsonfilter -e '@.ok' 2>/dev/null)
	case "$valid" in true|false) ;; *) result='{"ok":false,"error":"Apply stopped without a valid result; inspect /var/run/afzoon/apply.log"}';; esac
	printf '%s\n' "$result" > "$JOB_FILE.tmp"
	mv "$JOB_FILE.tmp" "$JOB_FILE"
}

finish_apply_worker() {
	if [ "$(jsonfilter -i "$JOB_FILE" -e '@.running' 2>/dev/null)" = true ]; then
		reply_error 'Apply worker stopped; inspect /var/run/afzoon/apply.log before retrying' > "$JOB_FILE.tmp"
		mv "$JOB_FILE.tmp" "$JOB_FILE"
	fi
	rm -f "$JOB_LOCK/pid"
	rmdir "$JOB_LOCK" 2>/dev/null
}

apply_status() {
	[ "$(cat "$STATE_DIR/apply-id" 2>/dev/null)" = "$1" ] && [ -s "$JOB_FILE" ] || { reply_error 'Unknown Apply operation'; return; }
	if [ "$(jsonfilter -i "$JOB_FILE" -e '@.running' 2>/dev/null)" = true ] && [ -d "$JOB_LOCK" ]; then
		worker_pid=$(cat "$JOB_LOCK/pid" 2>/dev/null)
		if is_uint "$worker_pid" && ! kill -0 "$worker_pid" 2>/dev/null; then
			if [ "$(jsonfilter -i "$JOB_FILE" -e '@.running' 2>/dev/null)" = true ]; then
				reply_error 'Apply worker stopped; inspect /var/run/afzoon/apply.log before retrying'
				return
			fi
		fi
	fi
	cat "$JOB_FILE"
}

case "$1" in
	status) status | tee "$STATE_FILE" ;;
	hotplug) printf '%s %s\n' "$2" "$3" > "$STATE_DIR/event"; status > "$STATE_FILE" ;;
	apply) if [ -d "$JOB_LOCK" ]; then reply_error 'An Apply operation is already in progress'; else result=$(apply "$2" "$3" "$4" 2>"$STATE_DIR/apply.log"); printf '%s\n' "$result" | tail -n 1; fi ;;
	start-apply) start_apply "$2" "$3" "$4" ;;
	apply-worker) apply_worker "$2" "$3" "$4" "$5" ;;
	apply-status) apply_status "$2" ;;
	safe-remove) safe_remove "$2" ;;
	disable-extroot) disable_extroot ;;
	language) [ "$2" = fa ] || [ "$2" = en ] || exit 2; uci set afzoon.main.language="$2"; uci commit afzoon; echo '{"ok":true}' ;;
	*) echo 'Usage: afzoonctl status|apply DEVICE SWAP_MIB EXTROOT_MIB|safe-remove DEVICE'; exit 2 ;;
esac
